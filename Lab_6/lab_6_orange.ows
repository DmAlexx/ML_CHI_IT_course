		<properties node_id="18" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\xf3\x00\x00\x00l\x00\x00\x05\x9f\x00\x00\x03\x8f\x00\x00\x00\xf3\x00\x00\x00\x88\x00\x00\x05\x9f\x00\x00\x03\x8f\x00\x00\x00\x00\x00\x00\x00\x00\x05\xe8\x00\x00\x00\xf3\x00\x00\x00\x88\x00\x00\x05\x9f\x00\x00\x03\x8f', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'from Orange.classification import Learner, Model\nfrom Orange.data import Table\nimport numpy as np\n\nclass RuleBasedModel(Model):\n    def predict(self, X):\n        predictions = []\n        for x in X:\n            if x["PetalLengthCm"] &lt; 2:\n                predictions.append(0)  # Iris-setosa\n            elif x["PetalWidthCm"] &lt; 1.5:\n                predictions.append(1)  # Iris-versicolor\n            else:\n                predictions.append(2)  # Iris-virginica\n        return np.array(predictions)\n\nclass RuleBasedLearner(Learner):\n    def __call__(self, data):\n        return RuleBasedModel(data.domain)\n\nlearner = RuleBasedLearner()\n', 'filename': None}], 'scriptText': 'from Orange.classification import Learner, Model\nimport numpy as np\n\nclass RuleBasedModel(Model):\n    def __init__(self, domain):\n        self.domain = domain\n        self.petal_length_idx = domain.index(domain["PetalLengthCm"])\n        self.petal_width_idx = domain.index(domain["PetalWidthCm"])\n\n    def predict(self, X):\n        predictions = []\n        for row in X:\n            if row[self.petal_length_idx] &lt; 2:\n                predictions.append(0)  # Iris-setosa\n            elif row[self.petal_width_idx] &lt; 1.5:\n                predictions.append(1)  # Iris-versicolor\n            else:\n                predictions.append(2)  # Iris-virginica\n        return np.array(predictions, dtype=int).reshape(-1)\n\nclass RuleBasedLearner(Learner):\n    def __call__(self, data):\n        return RuleBasedModel(data.domain)\n\nlearner = RuleBasedLearner()\n\nout_learner = learner\nout_data = None\nout_classifier = None\nout_object = None\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa8\x00\x00\x00h\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
